# MMDx Configuration
# Copy this file to .env and fill in your values

# Flask Settings
SECRET_KEY=change-me-to-a-long-random-secret-key
ADMIN_PASSWORD=change-this-admin-password
DATABASE_PATH=warehouse.db
FLASK_DEBUG=0
FLASK_RUN_HOST=127.0.0.1
PORT=5000

# Peyvast/SDAD Panel Integration
# These are required for stock sync to work
PEYVAST_BASE_URL=https://panel.sdadparts.com
PEYVAST_USERNAME=lab@sdadparts.com
PEYVAST_PASSWORD=Lab!1234

# Google OAuth (optional - for Gmail integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Email SMTP Settings (optional - for direct SMTP email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
