# MMDx Configuration
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# =============================================================================
# REQUIRED SETTINGS (Must be set for production)
# =============================================================================

# Flask secret key - Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# CRITICAL: This must be a long, random string. Change the default immediately.
SECRET_KEY=change-me-to-a-long-random-secret-key-minimum-32-chars

# Admin password for initial setup
# CRITICAL: Change this to a strong password before deploying
ADMIN_PASSWORD=change-this-admin-password

# Database path (relative to project root or absolute path)
DATABASE_PATH=warehouse.db

# =============================================================================
# FLASK SETTINGS
# =============================================================================

FLASK_ENV=development  # Change to 'production' for production deployments
FLASK_DEBUG=0          # Set to 0 for production
FLASK_RUN_HOST=127.0.0.1
PORT=5000

# =============================================================================
# VAPID KEYS FOR WEB PUSH NOTIFICATIONS
# =============================================================================
# Generate keys with: python -c "from webpush import vapid; v = vapid.VAPID(); print('PUBLIC:', v.public_key); print('PRIVATE:', v.private_key)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@yourdomain.com

# =============================================================================
# Peyvast/SDAD Panel Integration (Optional)
# =============================================================================
# Only required if using stock sync feature
PEYVAST_BASE_URL=https://panel.sdadparts.com
PEYVAST_USERNAME=
PEYVAST_PASSWORD=

# =============================================================================
# Google OAuth (Optional - for Gmail integration)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# =============================================================================
# Email SMTP Settings (Optional - for direct SMTP email)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# =============================================================================
# CORS CONFIGURATION (for API endpoints)
# =============================================================================
# Comma-separated list of allowed origins, or leave empty to disable CORS
CORS_ORIGINS=

# =============================================================================
# RATE LIMITING
# =============================================================================
# Rate limit for login endpoint (per IP)
RATELIMIT_LOGIN=10 per minute
